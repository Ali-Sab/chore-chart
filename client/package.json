{
  "name": "chore-chart",
  "private": true,
  "version": "0.0.1",
  "description": "Annual chore-tracking calendar for Alison & Kevina",
  "repository": {
    "type": "git",
    "url": "git@github.com:Ali-Sab/chore-chart.git"
  },
  "type": "module",
  "scripts": {
